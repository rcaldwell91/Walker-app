# Copy to .env.local and fill in from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Base URL used in client invite links
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional. Map tiles and geocoding default to OpenStreetMap / Nominatim (free, no key).
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# GEOCODER_URL=https://nominatim.openstreetmap.org
# Web Push (VAPID). Generate once per environment with: npx web-push generate-vapid-keys
# The public key is shared with browsers; keep the private key secret (never commit it).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: mailto: or https: URL
VAPID_SUBJECT=mailto:you@example.com
